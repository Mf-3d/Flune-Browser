  },
  "homepage": "https://github.com/mf-3d/flune-browser#readme",
  "dependencies": {
    "electron-store": "^8.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "electron-vite": "^5.0.0",
    "playwright": "^1.57.0",
    "vite": "^7.3.1"
  }
