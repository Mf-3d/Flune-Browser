{
  "name": "flune-browser",
  "version": "3.0.0",
  "description": "Newer and more challenging than anyone else.",
  "main": "src/main.js",
  "scripts": {
    "test": "playwright test",
    "start": "npm run build & electron .",
    "build": "tsc",
    "package": "electron-builder --dir",
    "package:win": "electron-builder --win --x64",
    "package:mac": "electron-builder --mac --x64"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mf-3d/flune-browser.git"
  },
  "author": "mf7cli",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mf-3d/flune-browser/issues"
  },
  "homepage": "https://github.com/mf-3d/flune-browser#readme",
  "dependencies": {
    "electron-store": "^8.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8",
    "playwright": "^1.57.0"
  },
  "build": {
    "appId": "io.github.mf-3d.flune-browser",
    "productName": "Flune-Browser",
    "artifactName": "${productName}-${version}-${platform}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "!src/**/*.ts"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "win": {
      "icon": "./src/assets/image/icon.png",
      "target": [
        "nsis",
        "zip"
      ],
      "signtoolOptions": {
        "publisherName": "mf7cli"
      }
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${platform}-${arch}-installer.exe"
    },
    "mac": {
      "icon": "./src/assets/image/icon.png",
      "category": "public.app-category.utilities",
      "target": {
        "target": "dmg",
        "arch": "universal"
      },
      "identity": null
    },
    "linux": {
      "icon": "./src/assets/image/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
