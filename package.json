{
  "name": "flune-browser",
  "version": "3.0.0",
  "description": "Newer and more challenging than anyone else.",
  "main": "out/main/main.js",
  "scripts": {
    "test": "playwright test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "prebuild": "electron-vite build",
    "package": "npm run prebuild & electron-builder --dir --config electron-builder.config.ts",
    "package:win": "npm run prebuild & electron-builder --win --x64 --config electron-builder.config.ts",
    "package:mac": "npm run prebuild & electron-builder --mac --x64 --config electron-builder.config.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
