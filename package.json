{
  "name": "flune-browser",
  "version": "3.0.0-beta.3",
  "description": "Newer and more challenging than anyone else.",
  "main": "out/main/main.js",
  "scripts": {
    "test": "playwright test",
    "start": "npm run check & electron-vite preview -- --runtime=vite-preview",
    "dev": "npm run check & electron-vite dev -- --runtime=vite-server",
    "check": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "electron-vite build",
    "package": "electron-builder build --publish never --config electron-builder.config.ts",
    "package:win": "electron-builder build --win --x64 --config electron-builder.config.ts",
    "package:mac": "electron-builder build --mac --x64 --config electron-builder.config.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mf-3d/flune-browser.git"
  },
  "author": "mf7cli",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mf-3d/flune-browser/issues"
  },
  "homepage": "https://github.com/mf-3d/flune-browser#readme",
  "dependencies": {
    "chalk": "4.1.2",
    "electron-store": "^8.2.0",
    "semver-parser": "^4.1.8",
    "strip-ansi": "6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^7.3.2"
  }
}
